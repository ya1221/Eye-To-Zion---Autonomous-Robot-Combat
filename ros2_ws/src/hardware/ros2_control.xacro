<ros2_control name="AckermannSystem" type="system">
  <hardware>
    <plugin>motor_driver/MotorDriver</plugin>
    <param name="pwm_device">/dev/pwmchip0</param>
  </hardware>

  <joint name="front_left_steering_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="effort"/>
    <param name="pwm_channel">0</param>
  </joint>

  <joint name="front_right_steering_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="effort"/>
    <param name="pwm_channel">1</param>
  </joint>

  <joint name="front_left_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="velocity"/>
    <state_interface name="effort"/>
    <param name="pwm_channel">2</param>
  </joint>

    <joint name="front_right_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="velocity"/>
    <state_interface name="effort"/>
    <param name="pwm_channel">3</param>
  </joint>

  <joint name="rear_left_wheel_joint">
    <state_interface name="position"/> 
    <state_interface name="velocity"/>
    <state_interface name="effort"/>
  </joint>

    <joint name="rear_right_wheel_joint">
    <state_interface name="position"/> 
    <state_interface name="velocity"/>
    <state_interface name="effort"/>
  </joint>
</ros2_control>