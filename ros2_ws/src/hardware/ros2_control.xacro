<?xml version="1.0"?>
<robot name="ros2_control" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="AckermannSystem" type="system">
    <hardware>
      <plugin>motor_driver/MotorDriver</plugin>
      <param name="pwm_device">/sys/class/pwm/pwmchip0</param>
      <!-- libgpiod chip name for L298N direction pins -->
      <!-- Pi 5 RP1 = "gpiochip0" (pinctrl-rp1, 54 lines). Verify with: gpiodetect -->
      <param name="gpio_chip">gpiochip0</param>
    </hardware>

    <joint name="front_left_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="front_right_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Left motor: ENA=PWM ch0 (GPIO12/pin32), IN1=GPIO27 (pin13), IN2=GPIO22 (pin15) -->
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="pwm_channel">0</param>
      <param name="in1_gpio">17</param>
      <param name="in2_gpio">27</param>
    </joint>

    <!-- Right motor: ENB not connected yet. IN3=GPIO23 (pin16), IN4=??? -->
    <!-- WARNING: Physical pin 17 is 3.3V POWER, not a GPIO! Verify your wiring! -->
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="pwm_channel">1</param>
      <param name="in1_gpio">22</param>
      <param name="in2_gpio">23</param>
    </joint>

    <joint name="rear_left_wheel_joint">
      <state_interface name="position"/> 
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

      <joint name="rear_right_wheel_joint">
      <state_interface name="position"/> 
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
</robot>