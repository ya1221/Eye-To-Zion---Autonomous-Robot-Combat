<?xml version="1.0"?>
<robot name="ackermann_steering_vehicle">

  <!-- ===== Links ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.3 0.2 0.15"/></geometry>
      <material name="body_material"><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.3 0.2 0.15"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>        
      <mass value="4.0"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.12"/>   
    </inertial>
  </link>

  <link name="front_left_steering_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder radius="0.01" length="0.001"/></geometry></visual>
    <inertial><origin xyz="0 0 0"/><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <link name="front_right_steering_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder radius="0.01" length="0.001"/></geometry></visual>
    <inertial><origin xyz="0 0 0"/><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <link name="front_left_wheel_link">
    <visual><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.06" length="0.03"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.06" length="0.03"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.000975" ixy="0" ixz="0" iyy="0.000975" iyz="0" izz="0.0018"/>
    </inertial>
  </link>

  <link name="front_right_wheel_link">
    <visual><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.06" length="0.03"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.06" length="0.03"/></geometry></collision>
   <inertial>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.000975" ixy="0" ixz="0" iyy="0.000975" iyz="0" izz="0.0018"/>
    </inertial>
  </link>

  <link name="rear_left_wheel_link">
    <visual><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.06" length="0.03"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.06" length="0.03"/></geometry></collision>
   <inertial>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.000975" ixy="0" ixz="0" iyy="0.000975" iyz="0" izz="0.0018"/>
    </inertial>
  </link>

  <link name="rear_right_wheel_link">
    <visual><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.06" length="0.03"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.06" length="0.03"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.000975" ixy="0" ixz="0" iyy="0.000975" iyz="0" izz="0.0018"/>
    </inertial>
  </link>

  <link name="camera_link">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.02 0.02 0.02"/></geometry></visual>
    <collision><origin xyz="0 0 0"/><geometry><box size="0.02 0.02 0.02"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <link name ="lidar_link">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.02 0.02 0.02"/></geometry></visual>
    <collision><origin xyz="0 0 0"/><geometry><box size="0.02 0.02 0.02"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <!-- <link name="turret_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder radius ="0.01" length="0.10"/></geometry></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder radius ="0.01" length="0.15"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link> -->

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <!-- small, non-zero inertia -->
      <inertia ixx="1e-6" ixy="0" ixz="0"
              iyy="1e-6" iyz="0"
              izz="1e-6"/>
    </inertial>

    <!-- optional: helps visualization / collision; can be removed -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
    </collision>
  </link>


  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="turret_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
  </gazebo>
    
  <!-- ===== Joints ===== -->
  
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/><child link="front_left_steering_link"/>
    <origin xyz="0.12 0.115 -0.06"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.819" upper="0.819" effort="30.0" velocity="30.0"/>
    <dynamics damping="0.2" friction="0.0"/>
  </joint>

  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/><child link="front_right_steering_link"/>
    <origin xyz="0.12 -0.115 -0.06"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.819" upper="0.819" effort="30.0" velocity="30.0"/>
    <dynamics damping="0.2" friction="0.0"/>
  </joint>

  <!-- Front wheels -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering_link"/><child link="front_left_wheel_link"/>
    <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
    <limit effort="30" velocity="30"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steering_link"/><child link="front_right_wheel_link"/>
    <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
    <limit effort="30" velocity="30"/>
  </joint>

  <!-- Rear wheels -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_left_wheel_link"/>
    <origin xyz="-0.12 0.115 -0.06"/><axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
    <limit effort="30" velocity="30"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_right_wheel_link"/>
    <origin xyz="-0.12 -0.115 -0.06"/><axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
    <limit effort="30" velocity="30"/> 
  </joint>


  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.16 0 0.05" rpy="0 0.0 0"/>
  </joint>

  <joint name="lidar_joint" type="fixed">
    <parent link ="base_link"/><child link="lidar_link"/>
    <origin xyz = "0.0 0 0.085" rpy="0 0 0"/>
  </joint>

  <!-- <joint name="turret_joint" type="fixed">
    <parent link="base_link"/><child link ="turret_link"/>
    <origin xyz = "0.20 0 0.0" rpy="0 1.5708 0"/>
  </joint> -->

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- set this to the real IMU position/orientation -->
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ===== Gazebo Classic tags ===== -->
  <!-- Friction -->
  <gazebo reference="base_link"><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>
  <gazebo reference="front_left_wheel_link">
    <mu1>2.0</mu1>   <!-- rolling -->
    <mu2>2.0</mu2>   <!-- lateral -->
    <kp>500000.0</kp> 
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel> 
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>500000.0</kp> 
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel> 
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>500000.0</kp> 
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel> 
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>500000.0</kp> 
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel> 
  </gazebo>


  <ros2_control name="GazeboSystem" type="system">
    <!-- In Gazebo Classic use this hardware -->
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <!-- Steering: position command -->
    <joint name="front_left_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="front_right_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Drive wheels: velocity command -->
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/> 
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

     <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/> 
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="rear_left_wheel_joint">
      <state_interface name="position"/> 
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

     <joint name="rear_right_wheel_joint">
      <state_interface name="position"/> 
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>


  <!-- A) The simulated camera sensor -->
  <gazebo reference="camera_link">
    <sensor name="imx462_rgb" type="camera">
      <update_rate>30</update_rate>
      <visualize>false</visualize>

      <camera>
        <horizontal_fov>2.46</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
        <!-- noise can stay here -->
        <!--
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
        -->
      </camera>

      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera/imx462</namespace>
          <remapping>image_raw:=/camera/imx462/image_raw</remapping>
          <remapping>camera_info:=/camera/imx462/camera_info</remapping>
        </ros>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="tg15" type="ray">
      <update_rate>26</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize> <!-- set false if you don't want beams drawn -->

      <ray>
        <scan>
          <horizontal>
            <samples>1440</samples>
            <resolution>1</resolution>
            <min_angle>-3.1415</min_angle>  <!-- -90° -->
            <max_angle>3.1415</max_angle>  <!-- +90° -->
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>

        <range>
          <min>0.15</min>
          <max>15.0</max>
          <resolution>0.01</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      
      <plugin name="gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/lidar/tg15</namespace>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <frame_name>lidar_link</frame_name>
        <output_type>sensor_msgs/LaserScan</output_type>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">

      <!-- ROS 2 bridge plugin -->
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu</remapping>   <!-- publishes /imu -->
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>

      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>  <!-- can be true, but not needed -->
    </sensor>
  </gazebo>

  <!--Plugins-->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>/home/itay3711/AutonomousWarfare/install/robot_description/share/robot_description/config/controllers.yaml</parameters>

      <ros>
        <namespace>/</namespace>
        <remapping>ackermann_steering_controller/odometry:=/odom</remapping>
        <remapping>ackermann_steering_controller/reference_unstamped:=/cmd_vel</remapping> 
      </ros>
    </plugin>
  </gazebo>

</robot>
