# ==========================================
# Eye-To-Zion Environment Variables
# ==========================================

# Robot Identification
# Used by the telemetry system and tactical brain to identify this specific unit.
ROBOT_ID=1

# Network & Telemetry (InfluxDB)
# URL of the InfluxDB server (e.g., local network IP or cloud URL)
INFLUX_URL=http://localhost:8086
# Authentication token for InfluxDB
INFLUX_TOKEN=your_super_secret_influx_token_here
# Organization name in InfluxDB
INFLUX_ORG=EyeToZion
# Bucket name for telemetry data
INFLUX_BUCKET=robot_telemetry

# Camera Overrides (Optional)
# Set to 'false' if your camera is mounted upright instead of inverted
CAMERA_INVERTED=true

# ROS2 Domain ID (Optional, uncomment if you have multiple robots/networks)
# ROS_DOMAIN_ID=42
