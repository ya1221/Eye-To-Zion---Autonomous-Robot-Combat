# Copy to .env and fill in. .env is gitignored - never commit a real key.
# Generate a key at: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-REPLACE_ME

# The name this machine shows up as in the tailnet. Must be unique per
# machine, and must match what other configs expect: the zenoh_bridge
# `-e tcp/<host>:7447` endpoint list in
# AutonomousWarfare/AutonomousWarfare/docker-compose.yml connects by these
# names. Devices actually registered in the tailnet, per `tailscale status`:
# yahav-laptop, yahav-rpi-1, r2d2, remote-pc, shay-laptop, wall-e.
TS_HOSTNAME=CHANGE_ME

# --accept-dns=true lets tailscaled manage DNS, which enables MagicDNS name
# resolution INSIDE THIS CONTAINER ONLY. It cannot reach the host or other
# containers: /etc/resolv.conf is per mount-namespace, and network_mode:host
# shares only the network namespace. See README.md for how to give other
# containers (e.g. zenoh_bridge) MagicDNS via `dns:` + `dns_search:`.
TS_EXTRA_ARGS=--accept-dns=true
