<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ai_vision</name>
  <version>1.0.0</version>
  <description>
    Eye-To-Zion vision pipeline: camera capture, YOLO inference,
    and threat assessment — all in one ROS 2 package.
  </description>
  <maintainer email="todo@todo.com">Eye-To-Zion</maintainer>
  <license>AGPL-3.0</license>



  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>foxglove_msgs</depend>

  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- ai_inference_node resolves the NCNN model out of the package share dir -->
  <exec_depend>ament_index_python</exec_depend>
  <!-- both containers start their node via `ros2 launch` -->
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>