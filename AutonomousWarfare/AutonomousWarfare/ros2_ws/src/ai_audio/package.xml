<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ai_audio</name>
  <version>1.0.0</version>
  <description>
    Eye-To-Zion audio pipeline: mic capture, impact-trigger detection,
    and onboard CNN classification of chassis hits.
  </description>
  <maintainer email="todo@todo.com">Eye-To-Zion</maintainer>
  <license>AGPL-3.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <!-- audio_processor_node resolves the model out of the package share dir -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
